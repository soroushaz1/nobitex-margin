{
  "appId": "ir.personal.nobitexmargin",
  "appName": "دستیار تعهدی",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "ir.personal.nobitexmargin.scan",
      "src": "runners/background.js",
      "event": "checkMarket",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
